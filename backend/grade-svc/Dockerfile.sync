# 云同步服务 sync-svc：与判分服务同 module 的第二命令（backend/grade-svc/cmd/syncsvc）。
# 科目无关（subject 仅作槽位分区键）、不持 QWEN 密钥、不吃 SUBJECT_DIR；存储为 PostgreSQL（DATABASE_URL）。
# 构建上下文 = 仓库根：docker build -f backend/grade-svc/Dockerfile.sync .
# 旧 SQLite 卷 portal-store 不再挂载，保留在宿主机供导出/回滚。
FROM golang:1.26-alpine AS build
WORKDIR /src
# 国内构建慢/不通时可：docker build --build-arg GOPROXY=https://goproxy.cn,direct
ARG GOPROXY
ENV GOPROXY=${GOPROXY:-https://proxy.golang.org,direct}
COPY backend/grade-svc/go.mod backend/grade-svc/go.sum ./
RUN go mod download
COPY backend/grade-svc/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sync-svc ./cmd/syncsvc

FROM alpine:3.21
RUN adduser -D -H -u 10001 svc
WORKDIR /app
COPY --from=build /out/sync-svc ./sync-svc
# 容器内绑 0.0.0.0：仅 compose 内部网络可达，compose 不映射端口到宿主（宿主 nginx 无感知）；
# 本服务不落本地文件，无需 root，以非特权用户运行。
ENV SYNC_HOST=0.0.0.0 SYNC_PORT=8793
EXPOSE 8793
USER svc
HEALTHCHECK --interval=5s --timeout=3s --start-period=3s CMD wget -qO- http://127.0.0.1:8793/api/health >/dev/null || exit 1
ENTRYPOINT ["/app/sync-svc"]
